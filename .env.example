# Copy to .env and fill in the key for whichever provider you use.
# .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# Claude vision (default provider). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional alternatives. Only the one matching --provider is needed.
# OPENAI_API_KEY=          # https://platform.openai.com/api-keys
# GROQ_API_KEY=            # https://console.groq.com/keys
# XAI_API_KEY=             # https://console.x.ai

# No key at all? Use --provider mock for an offline demo.
