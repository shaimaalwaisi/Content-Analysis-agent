# Copy to .env and fill in your Anthropic key.
# .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# Claude vision. Required: this project calls Claude and nothing else.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: a Tavily key turns on --enrich, which looks a product up to
# justify the tags an image cannot show (awards, benchmark, energy rating).
# TAVILY_API_KEY=          # https://app.tavily.com
