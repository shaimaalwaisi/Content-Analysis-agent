# Copy to .env and fill in your Anthropic key.
# .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# Claude vision. Required: this project calls Claude and nothing else.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --enrich looks a product up to justify the tags an image cannot show
# (awards, benchmark, energy rating). It needs no second key: with
# --search-tool anthropic the search runs on Anthropic's side against the key
# above, and the default --search-tool mock is offline.
